# Hesabyar Environment Configuration

# Application Environment (development, production)
HESABYAR_ENV=development

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE_PATH=data/hesabyar.log
LOG_MAX_BYTES=10485760  # 10 MB
LOG_BACKUP_COUNT=5

# Directory Paths (Relative to project root or absolute paths)
DATA_DIR=data
INPUT_DIR=data/input
OUTPUT_DIR=data/output
CACHE_DIR=data/cache
GROUND_TRUTH_DIR=data/ground_truth

# State Database Path (SQLite)
DB_PATH=data/hesabyar_state.db

# Processing & Concurrency
MAX_WORKERS=4
BATCH_SIZE=20

# OCR Engine Settings
OCR_ENGINE=easyocr
OCR_LANG=fa
USE_GPU=true

# LLM Fallback (Phase 4)
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
